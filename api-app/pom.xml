<project>
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.testcase</groupId>
		<artifactId>testcase-system</artifactId>
		<version>1.0.0</version>
	</parent>

	<artifactId>api-app</artifactId>

	<dependencies>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- JDBC driver: the code that actually speaks PostgreSQL's network protocol.
		     "runtime" = not needed to compile, only when the app runs. Version comes from the Spring Boot BOM. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Actuator: ready-made monitoring endpoints such as /actuator/health.
		     Docker and Jenkins will call /actuator/health to check that a deploy worked. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<dependency>
			<groupId>com.testcase</groupId>
			<artifactId>lib-model</artifactId>
		</dependency>

		<dependency>
			<groupId>com.testcase</groupId>
			<artifactId>lib-core</artifactId>
		</dependency>

		<dependency>
			<groupId>com.testcase</groupId>
			<artifactId>user-module</artifactId>
		</dependency>

		<dependency>
			<groupId>com.testcase</groupId>
			<artifactId>testcase-module</artifactId>
		</dependency>

		<dependency>
			<groupId>com.testcase</groupId>
			<artifactId>testrun-module</artifactId>
		</dependency>
		<dependency>
			<groupId>com.testcase</groupId>
			<artifactId>project-module</artifactId>
		</dependency>

	</dependencies>

	<build>
		<plugins>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

		</plugins>
	</build>

</project>